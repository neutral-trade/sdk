{
  "name": "@neutral-trade/sdk",
  "type": "module",
  "version": "1.0.5",
  "packageManager": "pnpm@10.25.0",
  "description": "Neutral Trade vault registry and Codama-generated ntbundle client for @solana/kit",
  "license": "MIT",
  "homepage": "https://github.com/neutral-trade/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neutral-trade/sdk.git"
  },
  "bugs": "https://github.com/neutral-trade/sdk/issues",
  "keywords": [
    "solana",
    "neutral-trade",
    "ntbundle",
    "sdk",
    "codama",
    "solana-kit"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./generated": "./dist/generated/index.mjs",
    "./idl": "./dist/idl/index.mjs",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "cli": "pnpm --filter @neutral-trade/cli dev --",
    "generate": "node --import tsx scripts/generate-vault-ids.ts",
    "prebuild": "pnpm generate",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint",
    "prepublishOnly": "nr build",
    "release": "bumpp",
    "start": "tsx src/index.ts",
    "test": "vitest",
    "typecheck": "tsc",
    "docs:build": "typedoc",
    "docs:preview": "pnpm docs:build && npx serve docs",
    "prepare": "simple-git-hooks"
  },
  "peerDependencies": {
    "@solana/kit": "^6.10.0"
  },
  "dependencies": {
    "@solana/program-client-core": "^6.10.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:cli",
    "@antfu/ni": "catalog:cli",
    "@antfu/utils": "catalog:inlined",
    "@solana/kit": "^6.10.0",
    "@types/chai": "^5.2.2",
    "@types/node": "catalog:types",
    "baseline-browser-mapping": "catalog:",
    "bumpp": "catalog:cli",
    "chai": "^5.2.0",
    "dotenv": "catalog:",
    "eslint": "catalog:cli",
    "lint-staged": "catalog:cli",
    "publint": "catalog:cli",
    "simple-git-hooks": "catalog:cli",
    "tinyexec": "catalog:testing",
    "tsdown": "catalog:cli",
    "tsx": "catalog:cli",
    "typedoc": "catalog:",
    "typescript": "catalog:cli",
    "vite": "catalog:cli",
    "vitest": "catalog:testing",
    "vitest-package-exports": "catalog:testing",
    "yaml": "catalog:testing"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm i --frozen-lockfile --ignore-scripts --offline && npx lint-staged"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,mts,cts,tsx,jsx}": "eslint --fix"
  }
}
