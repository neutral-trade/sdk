// Needed so the standalone Vite example checks browser APIs without emitting files.
{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@neutral-trade/sdk": ["../../src/index.ts"],
      "@neutral-trade/widget-sdk": ["../../packages/widget-sdk/src/index.ts"]
    },
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
